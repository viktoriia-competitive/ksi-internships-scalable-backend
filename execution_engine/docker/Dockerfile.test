ARG BASE_IMAGE=python:3.12-slim
FROM ${BASE_IMAGE}

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/workspace

RUN apt-get update \
    && apt-get install --yes --no-install-recommends bubblewrap procps util-linux \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY . /workspace/execution_engine

ENTRYPOINT ["python3", "-m", "pytest"]
CMD ["-q", "/workspace/execution_engine/tests"]
