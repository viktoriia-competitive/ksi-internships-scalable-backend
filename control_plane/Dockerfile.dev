FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# The development evaluator supports Python and C++ source artifacts.
# Keep compiler/runtime dependencies in the worker/API image so both services
# are built from exactly the same application environment.
RUN apt-get update \
    && apt-get install -y --no-install-recommends g++ gcc ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-dev.txt /app/requirements-dev.txt
COPY control_plane/requirements.txt /app/control_plane/requirements.txt
RUN python -m pip install --no-cache-dir -r /app/requirements-dev.txt

COPY . /app

EXPOSE 8000
